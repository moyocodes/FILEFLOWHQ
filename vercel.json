{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.fileflowhq.com" }],
      "destination": "https://fileflowhq.com/$1",
      "permanent": true
    },
    {
      "source": "/tools/pdf-to-text",
      "destination": "/tools/pdf-to-word",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index" }
  ]
}
