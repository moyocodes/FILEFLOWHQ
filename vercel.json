{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/studio-apps/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/studio-apps/(.*)\\.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.fileflowhq.com"
        }
      ],
      "destination": "https://fileflowhq.com/$1",
      "permanent": true
    },
    {
      "source": "/tools/pdf-to-text",
      "destination": "/tools/pdf-to-word",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/s/:code",
      "destination": "/api/s?code=:code"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index"
    }
  ]
}
