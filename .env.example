# Vite exposes only vars prefixed with VITE_ to client code. The vars below
# are server-only (used by api/send-confirmation.js) and must NOT get a
# VITE_ prefix, or the Mailjet private key would ship to the browser.
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MJ_SENDER_EMAIL=

# Optional. Comma-separated extra origins allowed to call the API from a
# Chrome extension, e.g. an unpacked build: chrome-extension://<id>
# (the published store extension is already allowed in api/_cors.js).
EXTENSION_ORIGINS=

# Upstash Redis, used by the URL shortener (api/shorten.js, api/s.js). Created
# from Vercel's Storage tab, which injects these automatically. The
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN names also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# In-house analytics (api/collect.js, api/stats.js; dashboard at /admin/stats).
# Uses the same Upstash Redis as the URL shortener. ANALYTICS_TOKEN is the
# password for the dashboard: pick a long random string. ANALYTICS_SALT keys
# the daily visitor hash (optional; defaults to the Redis token).
ANALYTICS_TOKEN=
ANALYTICS_SALT=

# Paystack (api/pay-init.js, pay-verify.js, pay-webhook.js). Secret key from
# the Paystack dashboard > Settings > API Keys & Webhooks. Server-only: no
# VITE_ prefix. Also add https://<your-domain>/api/pay-webhook as the webhook URL.
PAYSTACK_SECRET_KEY=
# Optional: public site URL Paystack returns users to (default https://fileflowhq.com).
SITE_URL=
# Optional: salt for hashing client IPs in Redis.
USAGE_SALT=

# Secret that exempts the site owner from the paywall. Pick a long random
# string, then visit https://<your-domain>/?owner=<that string> once on each
# of your devices. Leave empty to disable the exemption.
OWNER_KEY=
