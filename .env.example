# Vite exposes only vars prefixed with VITE_ to client code. The vars below
# are server-only (used by api/send-confirmation.js) and must NOT get a
# VITE_ prefix, or the Mailjet private key would ship to the browser.
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MJ_SENDER_EMAIL=

# Adobe PDF Services API credentials (used by api/pdf-to-word.js). Get these
# from https://acrobatservices.adobe.com/dc-integration-creation-app-cdn/main.html?api=pdf-services-api
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# Optional. Comma-separated extra origins allowed to call the API from a
# Chrome extension, e.g. an unpacked build: chrome-extension://<id>
# (the published store extension is already allowed in api/_cors.js).
EXTENSION_ORIGINS=

# Upstash Redis, used by the URL shortener (api/shorten.js, api/s.js). Created
# from Vercel's Storage tab, which injects these automatically. The
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN names also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
