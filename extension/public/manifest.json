{
  "manifest_version": 3,
  "name": "FileFlowHQ — File Converter",
  "version": "1.0.0",
  "description": "Convert images, PDFs, and data files for free, right in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open FileFlowHQ"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel"]
}
