+impl WebApp {
+    /// FileFlowHQ Studio: follow the page's theme, save when it asks or when AutoSave is due, and
+    /// tell it about unsaved changes.
+    fn host_requests(&mut self, ctx: &egui::Context) {
+        let req = host::take_requests();
+        if let Some(dark) = req.dark {
+            self.app.set_theme(ctx, if dark { filmcraft_ui_egui::theme::ThemeKind::Dark } else { filmcraft_ui_egui::theme::ThemeKind::Light });
+        }
+        let s = &self.app.session;
+        let dirty = s.revision != s.saved_revision;
+        if host::should_save(req.save, dirty) {
+            let path = self.app.session.path.clone().unwrap_or_else(|| {
+                let name = self.app.session.project.name.trim();
+                format!("/{}.fcproj", if name.is_empty() { "Project" } else { name })
+            });
+            let save = |app: &mut filmcraft_ui_egui::FilmcraftApp| app.session.execute("file.save", json!({"path": path}));
+            let r = if req.save { save(&mut self.app) } else { host::autosaving(|| save(&mut self.app)) };
+            if let Err(e) = r {
+                log::warn!("save failed: {e}");
+            }
+        }
+        let s = &self.app.session;
+        host::report_dirty(s.revision != s.saved_revision);
+        if dirty {
+            ctx.request_repaint_after(std::time::Duration::from_millis(1500));
+        }
+    }
+}
+
