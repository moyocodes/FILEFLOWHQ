 struct WebShell {
     fig: FigApp,
+    inbox: Inbox,
+}
+
+impl WebShell {
+    /// Open, import or place the files that arrived.
+    fn drain_inbox(&mut self) {
+        let files = std::mem::take(&mut *self.inbox.borrow_mut());
+        for (purpose, name, bytes) in files {
+            web_files::add(&name, bytes);
+            match purpose {
+                Purpose::Open => {
+                    if self.fig.run("file.open", json!({"path": name})).is_some() {
+                        self.fig.ui.home = false;
+                    }
+                }
+                Purpose::Import => {
+                    self.fig.run("file.import", json!({"path": name}));
+                }
+                Purpose::Place => {
+                    self.fig.run("file.placeImage", json!({"path": name}));
+                }
+            }
+        }
+    }
+
+    /// FileFlowHQ Studio: follow the page's theme, save when it asks or when AutoSave is due, and
+    /// tell it about unsaved changes.
+    fn host_requests(&mut self, ctx: &egui::Context) {
+        let req = crate::host::take_requests();
+        if let Some(dark) = req.dark {
+            self.fig.run(if dark { "view.themeDark" } else { "view.themeLight" }, json!({}));
+        }
+        let dirty = self.fig.session.docs.iter().any(|d| d.is_dirty());
+        let active_dirty = self.fig.session.docs.get(self.fig.session.active).is_some_and(|d| d.is_dirty());
+        if crate::host::should_save(req.save, active_dirty) && !self.fig.ui.home {
+            let save = |fig: &mut FigApp| {
+                let Some(d) = fig.session.docs.get(fig.session.active) else { return };
+                if d.path.is_some() {
+                    fig.run("file.save", json!({}));
+                } else {
+                    let name = format!("{}.figcraft", d.doc.name);
+                    fig.run("file.saveAs", json!({"path": name}));
+                }
+            };
+            if req.save { save(&mut self.fig) } else { crate::host::autosaving(|| save(&mut self.fig)) }
+        }
+        crate::host::report_dirty(dirty);
+        if dirty {
+            ctx.request_repaint_after(std::time::Duration::from_millis(1500));
+        }
+    }
 }
 
