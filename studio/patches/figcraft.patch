diff --git a/crates/engine/src/web_files.rs b/crates/engine/src/web_files.rs
new file mode 100644
index 0000000..7275cf1
--- /dev/null
+++ b/crates/engine/src/web_files.rs
@@ -0,0 +1,37 @@
+//! FileFlowHQ Studio: files in the browser, which has no file system. Files the visitor opens
+//! are kept here by name (the web shell adds them), and every file the engine writes goes to a
+//! delivery hook the web shell installs (the page keeps saves in the browser and downloads
+//! exports). Unused natively.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+type Deliver = Box<dyn Fn(&str, &[u8]) -> Result<(), String>>;
+
+thread_local! {
+    static FILES: RefCell<HashMap<String, Vec<u8>>> = RefCell::default();
+    static DELIVER: RefCell<Option<Deliver>> = const { RefCell::new(None) };
+}
+
+/// Keep `bytes` as the file `name` (a file the visitor opened).
+pub fn add(name: &str, bytes: Vec<u8>) {
+    FILES.with_borrow_mut(|f| f.insert(name.to_string(), bytes));
+}
+
+/// The file `path`, if the visitor opened or saved it in this visit.
+pub fn read(path: &str) -> Option<Vec<u8>> {
+    FILES.with_borrow(|f| f.get(path).cloned())
+}
+
+/// Install where written files go (once, when the web app starts).
+pub fn set_deliver(deliver: Deliver) {
+    DELIVER.with_borrow_mut(|d| *d = Some(deliver));
+}
+
+/// Hand a written file to the host, and keep it for reading back.
+pub fn write(path: &str, bytes: &[u8]) -> Result<(), String> {
+    let name = std::path::Path::new(path).file_name().map_or_else(|| path.to_string(), |n| n.to_string_lossy().to_string());
+    DELIVER.with_borrow(|d| d.as_ref().map_or_else(|| Err("saving isn't available here".to_string()), |deliver| deliver(&name, bytes)))?;
+    add(path, bytes.to_vec());
+    Ok(())
+}
