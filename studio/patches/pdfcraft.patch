+/// The typed file name, cleaned (no folders or control characters, at most 200 characters,
+/// ending in .pdf), when it differs from the document's name.
+fn renamed(app: &PdfCraftApp) -> Option<(pdfcraft_engine::DocId, String)> {
+    let (id, draft) = app.name_draft.as_ref()?;
+    let doc = app.session.get(*id)?;
+    let clean = clean_file_name(draft)?;
+    (clean != doc.name).then_some((*id, clean))
+}
+
+fn clean_file_name(typed: &str) -> Option<String> {
+    let name: String = typed.chars().map(|c| if c.is_control() || "/\\:*?\"<>|".contains(c) { '-' } else { c }).collect();
+    let name = name.trim().trim_matches('.').trim();
+    let stem = name.strip_suffix(".pdf").or_else(|| name.strip_suffix(".PDF")).unwrap_or(name).trim();
+    if stem.is_empty() {
+        return None;
+    }
+    Some(format!("{}.pdf", stem.chars().take(196).collect::<String>()))
+}
+
