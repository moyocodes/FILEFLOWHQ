+    resp.widget_info(|| egui::WidgetInfo::selected(egui::WidgetType::Button, true, active, label));
+    let press = theme::Press::track(ui, &resp);
+    let bg = if active { press.fill(t.accent_soft, t.accent_soft, t.selected) } else { press.fill(Color32::TRANSPARENT, t.hover, t.pressed) };
+    if bg.a() > 0 {
+        ui.painter().rect_filled(rect, CornerRadius::same(t.radius), bg);
+    }
+    let body = rect.translate(press.offset());
+    icons::paint(ui, Rect::from_min_size(body.min + vec2(9.0, (height - 16.0) / 2.0), vec2(16.0, 16.0)), "layout-grid", 15.0, if active { t.accent_text } else { t.text_muted });
+    ui.painter().text(body.left_center() + vec2(31.0, 0.0), Align2::LEFT_CENTER, label, font, if active { t.text } else { t.text_muted });
+    theme::hand(resp)
