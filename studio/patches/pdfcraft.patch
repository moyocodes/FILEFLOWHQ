+    /// Two seconds after the open documents change (opened, edited, renamed, closed), hand them
+    /// to the embedding page, which stores them in the browser for the next visit.
+    fn host_snapshot_frame(&mut self, ctx: &egui::Context) {
+        if self.host_snapshot.is_none() {
+            return;
+        }
+        let sig: Vec<(String, usize)> =
+            self.views.iter().filter_map(|v| self.session.get(v.id)).map(|d| (d.name.clone(), std::sync::Arc::as_ptr(&d.bytes) as usize)).collect();
+        let now = ctx.input(|i| i.time);
+        if sig != self.snapshot_sig {
+            self.snapshot_sig = sig;
+            self.snapshot_due = Some(now + 2.0);
+            ctx.request_repaint_after(std::time::Duration::from_millis(2100));
+        }
+        if self.snapshot_due.is_some_and(|due| now >= due) {
+            self.snapshot_due = None;
+            let docs: Vec<_> = self
+                .views
+                .iter()
+                .filter_map(|v| {
+                    let doc = self.session.get(v.id)?;
+                    let bytes = self.session.save_bytes(v.id).ok().unwrap_or_else(|| doc.bytes.clone());
+                    Some((doc.name.clone(), bytes))
+                })
+                .collect();
+            if let Some(report) = self.host_snapshot.as_mut() {
+                report(docs);
+            }
+        }
