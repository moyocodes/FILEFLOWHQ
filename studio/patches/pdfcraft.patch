diff --git a/crates/ui-egui/src/brand.rs b/crates/ui-egui/src/brand.rs
new file mode 100644
index 0000000..a03129a
--- /dev/null
+++ b/crates/ui-egui/src/brand.rs
@@ -0,0 +1,55 @@
+//! The FileFlowHQ logo: the green mark (the same SVG fileflowhq.com uses) and the "FileFlowHQ"
+//! wordmark set in Poppins beside it.
+
+use egui::{Rect, Response, Sense, Vec2, vec2};
+
+use crate::theme::{self, Tokens};
+
+const MARK: &[u8] = include_bytes!("../../../assets/brand/fileflowhq-mark.svg");
+/// The mark's width over its height (its viewBox is 87 × 54).
+const MARK_ASPECT: f32 = 87.0 / 54.0;
+
+/// The mark, `height` points tall.
+pub fn mark(height: f32) -> egui::Image<'static> {
+    egui::Image::from_bytes("bytes://brand/fileflowhq-mark.svg", MARK).fit_to_exact_size(vec2(height * MARK_ASPECT, height))
+}
+
+/// Paints the mark with its top-left corner at `min`; returns the rectangle it took.
+pub fn paint_mark(ui: &egui::Ui, min: egui::Pos2, height: f32) -> Rect {
+    let rect = Rect::from_min_size(min, vec2(height * MARK_ASPECT, height));
+    mark(height).paint_at(ui, rect);
+    rect
+}
+
+/// Mark plus wordmark, sized to a `height`-point mark. `suffix` (such as "PDF") follows the
+/// wordmark in the muted colour. Clicks go to the caller.
+pub fn logo(ui: &mut egui::Ui, height: f32, suffix: Option<&str>) -> Response {
+    let t = Tokens::get(ui.ctx());
+    let size = (height * 0.78).round();
+    let name = ui.painter().layout_no_wrap("FileFlowHQ".to_owned(), theme::semibold(size), t.text);
+    let extra = suffix.map(|s| ui.painter().layout_no_wrap(s.to_owned(), theme::medium(size), t.text_muted));
+    let gap = (height * 0.38).round();
+    let width = height * MARK_ASPECT + gap + name.size().x + extra.as_ref().map_or(0.0, |g| g.size().x + gap * 0.6);
+    let (rect, resp) = ui.allocate_exact_size(Vec2::new(width, height.max(name.size().y)), Sense::click());
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, "FileFlowHQ home"));
+    let press = theme::Press::track(ui, &resp);
+    let body = rect.translate(press.offset());
+    let mark_rect = paint_mark(ui, egui::pos2(body.left(), body.center().y - height / 2.0), height);
+    let x = mark_rect.right() + gap;
+    let name_w = name.size().x;
+    let painter = ui.painter();
+    painter.galley(egui::pos2(x, body.center().y - name.size().y / 2.0), name, t.text);
+    if let Some(g) = extra {
+        painter.galley(egui::pos2(x + name_w + gap * 0.6, body.center().y - g.size().y / 2.0), g, t.text_muted);
+    }
+    theme::hand(resp)
+}
+
+/// The mark alone, as a button (narrow windows).
+pub fn logo_mark(ui: &mut egui::Ui, height: f32) -> Response {
+    let (rect, resp) = ui.allocate_exact_size(vec2(height * MARK_ASPECT, height), Sense::click());
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, "FileFlowHQ home"));
+    let press = theme::Press::track(ui, &resp);
+    paint_mark(ui, rect.min + press.offset(), height);
+    theme::hand(resp)
+}
