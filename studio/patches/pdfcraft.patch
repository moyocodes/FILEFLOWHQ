+/// A segmented control (the top bar's modes): a quiet well with the active choice raised in
+/// it. Returns the index clicked.
+pub fn segmented(ui: &mut egui::Ui, labels: &[&str], active: usize) -> Option<usize> {
+    let t = Tokens::get(ui.ctx());
+    let (pad, h) = (3.0, 36.0);
+    let font = |on: bool| if on { theme::semibold(13.0) } else { theme::medium(13.0) };
+    let widths: Vec<f32> =
+        labels.iter().enumerate().map(|(i, l)| ui.fonts_mut(|f| f.layout_no_wrap((*l).to_owned(), font(i == active), t.text).size().x) + 26.0).collect();
+    let total = widths.iter().sum::<f32>() + 2.0 * pad;
+    let (rect, _) = ui.allocate_exact_size(vec2(total, h), Sense::hover());
+    ui.painter().rect(rect, CornerRadius::same(t.radius + 3), t.pasteboard, Stroke::new(1.0, t.divider), egui::StrokeKind::Inside);
+    let mut picked = None;
+    let mut x = rect.left() + pad;
+    for (i, (label, w)) in labels.iter().zip(widths).enumerate() {
+        let on = i == active;
+        let r = Rect::from_min_size(egui::pos2(x, rect.top() + pad), vec2(w, h - 2.0 * pad));
+        x += w;
+        let resp = ui.interact(r, ui.id().with(("segment", i)), Sense::click());
+        resp.widget_info(|| egui::WidgetInfo::selected(egui::WidgetType::Button, ui.is_enabled(), on, *label));
+        let press = theme::Press::track(ui, &resp);
+        if on {
+            if !t.dark() {
+                let shadow = egui::Shadow { offset: [0, 1], blur: 4, spread: 0, color: Color32::from_black_alpha(22) };
+                ui.painter().add(shadow.as_shape(r, CornerRadius::same(t.radius)));
+            }
+            ui.painter().rect(r, CornerRadius::same(t.radius), t.card, Stroke::new(1.0, t.border), egui::StrokeKind::Inside);
+        } else {
+            press.wash(ui, r, t.radius, false);
+        }
+        ui.painter().text(r.translate(press.offset()).center(), Align2::CENTER_CENTER, *label, font(on), if on { t.text } else { t.text_muted });
+        if theme::hand(resp).clicked() {
+            picked = Some(i);
+        }
+    }
+    picked
+}
