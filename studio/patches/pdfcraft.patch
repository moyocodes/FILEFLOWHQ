+/// A spinning arc: the loader for work under way. `time` is `InputState::time`; the caller
+/// keeps repainting while it shows.
+pub fn spinner(painter: &egui::Painter, center: egui::Pos2, radius: f32, color: Color32, time: f64) {
+    let width = (radius * 0.22).max(2.0);
+    painter.circle_stroke(center, radius, Stroke::new(width, color.gamma_multiply(0.18)));
+    let start = (time * 4.2) as f32;
+    let sweep = 1.6 + 0.9 * ((time * 2.1).sin() as f32);
+    let points: Vec<egui::Pos2> = (0..=24)
+        .map(|k| {
+            let a = start + sweep * k as f32 / 24.0;
+            center + radius * vec2(a.cos(), a.sin())
+        })
+        .collect();
+    painter.add(egui::Shape::line(points, Stroke::new(width, color)));
+}
